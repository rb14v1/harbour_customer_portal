# Copy to backend/.env
NODE_ENV=development
PORT=4100
MONGO_URI=mongodb://127.0.0.1:27018/customer_portal
CLIENT_ORIGIN=http://localhost:5180
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Leave SMTP_HOST empty to log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Customer Portal <no-reply@demo.local>"
